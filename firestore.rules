rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cotações: leitura pública, escrita somente via Functions (service account)
    match /exchange_rates/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Favoritos: apenas o próprio usuário
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Alertas: apenas o próprio usuário
    match /alerts/{alertId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Histórico: leitura pública (dados agregados, sem PII)
    match /history/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}

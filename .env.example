# Copy this file to .env.local and fill in values

# Firebase project config (public — safe in app bundle)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL of your deployed Firebase Functions
EXPO_PUBLIC_FIREBASE_FUNCTION_URL=https://<region>-<project-id>.cloudfunctions.net

# Exchange rate API key — store ONLY in Firebase Functions, never here
# EXCHANGE_API_KEY=  ← keep this in Firebase Functions config only
